{
  "name": "trieur-monorepo",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*", "site"],
  "scripts": {
    "build": "tsc -b packages/core packages/learn packages/server",
    "clean": "tsc -b --clean packages/core packages/learn packages/server",
    "check": "tsc -b packages/core packages/learn packages/server",
    "test": "bun test packages",
    "bench": "bun packages/learn/tools/bench.ts",
    "dev": "bun run --cwd site dev",
    "site": "bun run --cwd site build",
    "serve": "bun run --cwd packages/server dev"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.11.2",
    "@types/bun": "^1.3.0",
    "typescript": "^5.9.2"
  }
}
