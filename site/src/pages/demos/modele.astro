---
import '@trieur/core/trieur.css';
import DemoNav from '../../components/DemoNav.astro';
import Base from '../../layouts/Base.astro';
---

<Base title="Démo — le modèle qui apprend">
  <section class="wrap" style="padding-top:44px">
    <DemoNav />
    <h1 style="margin:0 0 8px">Le modèle, en direct</h1>
    <p style="color:var(--dim);max-width:70ch;margin:0 0 26px">
      Range quelques cartes et regarde la colonne de droite. Le modèle se tait tant qu'il n'a rien appris — une mauvaise
      proposition coûte plus cher que pas de proposition. Dès qu'il propose, <kbd>↵</kbd> accepte. Annuler avec
      <kbd>⌫</kbd> ne fait pas que remettre la carte&nbsp;: ça <em>désapprend</em> l'exemple.
    </p>

    <p style="margin:0 0 20px">
      <button class="btn primary" id="play">Rejouer 25 rangements</button>
      <button class="btn" id="reset">Repartir de zéro</button>
    </p>

    <div class="demo demo-side">
      <div id="deck"></div>
      <div>
        <div class="panel">
          <h3>Proposition</h3>
          <p id="guess" style="margin:0 0 6px;min-height:3em">—</p>
          <p class="why" id="why"></p>
        </div>
        <div class="panel">
          <h3>État</h3>
          <div class="kv"><span>rangements</span><b id="n">0</b></div>
          <div class="kv"><span>zones connues</span><b id="z">0</b></div>
          <div class="kv"><span>traits</span><b id="vocab">0</b></div>
          <div class="kv"><span>justesse (prequential)</span><b id="acc">—</b></div>
        </div>
        <div class="panel">
          <h3>Poids des membres</h3>
          <div id="weights"></div>
          <p style="color:var(--dim);margin:10px 0 0;font-size:12.5px">
            Personne ne décrète qui a raison&nbsp;: chaque membre est interrogé avant d'apprendre, et son poids suit ses
            erreurs passées.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="wrap prose" style="margin-top:70px">
    <h2>Le banc d'essai, dans ton navigateur</h2>
    <p>
      Le même code que <code>bun tools/bench.ts</code>, sur un corpus synthétique de 800 cartes où la zone dépend
      surtout de la <em>combinaison</em> domaine × tag. C'est le cas que Bayes naïf ne sait pas voir&nbsp;: chaque trait
      pris seul vote pareil des deux côtés.
    </p>
    <p><button class="btn primary" id="bench">Lancer le banc</button> <span id="bench-state" style="color:var(--dim)"></span></p>
    <table id="bench-table" style="margin-top:10px">
      <thead><tr><th>configuration</th><th>top-1</th><th>top-3</th><th>muet</th><th>traits</th></tr></thead>
      <tbody></tbody>
    </table>
    <p class="note">
      Sur ce corpus-là, croiser les traits fait gagner huit à neuf points à Bayes comme au linéaire, et le kNN passe
      devant. Sur un corpus réel de 3&nbsp;412 liens dans 72 dossiers, le même croisement ne rapporte qu'un demi-point —
      les signaux marginaux y dominent — et c'est l'ensemble qui prend l'avantage. D'où le banc&nbsp;:
      <a href="/docs/mesurer">mesure sur ton corpus</a>, ne recopie pas les chiffres des autres.
    </p>
  </section>
</Base>

<script>
  import { Deck } from '@trieur/core';
  import { createRecommender, Ensemble, LocalRecommender } from '@trieur/learn';
  import { crossed, evaluate, synth } from '@trieur/learn/bench';
  import { Bayes, Knn, Linear, tokens } from '@trieur/learn';
  import { meta, shuffled, zones, type Lien } from '../../data/liens';
  import { renderCard } from '../../scripts/card';

  const $ = <T extends Element = HTMLElement>(s: string) => document.querySelector<T>(s)!;
  const KEY = 'demo-modele';

  let brain = createRecommender({ key: KEY }) as LocalRecommender;
  const deck = new Deck<Lien>($('#deck'), {
    items: shuffled(7),
    zones,
    meta,
    renderCard,
    advisor: brain,
  });

  deck.root.addEventListener('trieur:suggest', (e) => {
    const d = (e as CustomEvent).detail;
    $('#guess').innerHTML = `→ <b>${d.id}</b><br /><small style="color:var(--dim)">${Math.round(d.score * 100)} % de confiance · <kbd>↵</kbd> pour accepter</small>`;
    $('#why').textContent = d.why.join('  ');
  });

  async function refresh() {
    const s = await brain.stats();
    $('#n').textContent = String(s.examples);
    $('#z').textContent = String(s.targets);
    $('#vocab').textContent = String(s.vocab);
    $('#acc').textContent = s.accuracy ? `${Math.round(s.accuracy * 100)} %` : '—';
    if (!deck.prediction) {
      $('#guess').textContent = s.examples ? 'Rien de tranché : le modèle préfère se taire.' : 'Aucun exemple appris pour l’instant.';
      $('#why').textContent = '';
    }
    const model = brain.model;
    if (model instanceof Ensemble) {
      $('#weights').innerHTML = Object.entries(model.weights)
        .map(
          ([k, w]) =>
            `<div class="kv" style="border:0;padding-bottom:0"><span>${k}</span><b>${Math.round(w * 100)} %</b></div><div class="bar"><i style="width:${(w * 100).toFixed(1)}%"></i></div>`,
        )
        .join('');
    }
  }
  for (const ev of ['trieur:sort', 'trieur:undo', 'trieur:skip']) deck.root.addEventListener(ev, () => void refresh());
  void refresh();

  // --- rejeu automatique : on range chaque carte là où elle « doit » aller ------
  $('#play').addEventListener('click', async () => {
    const btn = $<HTMLButtonElement>('#play');
    btn.disabled = true;
    for (let i = 0; i < 25 && deck.current; i++) {
      const zone = deck.zones.find((z) => z.id === deck.current!.folder);
      if (!zone) break;
      await deck.commit(zone);
      await new Promise((r) => setTimeout(r, 230));
    }
    btn.disabled = false;
  });

  $('#reset').addEventListener('click', async () => {
    await brain.destroy();
    await brain.store.remove(KEY);
    brain = createRecommender({ key: KEY }) as LocalRecommender;
    deck.setOptions({ advisor: brain });
    deck.setItems(shuffled(7));
    void refresh();
  });

  // --- le banc, en tâche coopérative -------------------------------------------
  $('#bench').addEventListener('click', async () => {
    const btn = $<HTMLButtonElement>('#bench');
    btn.disabled = true;
    const body = $('#bench-table tbody');
    body.innerHTML = '';
    const cards = synth(800);
    const suites: Array<[string, () => any, any]> = [
      ['bayes', () => new Bayes(), tokens],
      ['bayes + croisés', () => new Bayes(), crossed],
      ['linéaire', () => new Linear(), tokens],
      ['linéaire + croisés', () => new Linear(), crossed],
      ['kNN + croisés', () => new Knn(), crossed],
      ['ensemble + croisés', () => new Ensemble([new Bayes(), new Linear(), new Knn()]), crossed],
    ];
    for (const [name, make, extract] of suites) {
      $('#bench-state').textContent = `${name}…`;
      await new Promise((r) => setTimeout(r)); // on rend la main au navigateur entre deux
      const r = evaluate(name, make(), extract, cards);
      const pct = (x: number) => `${(x * 100).toFixed(1)} %`;
      body.insertAdjacentHTML(
        'beforeend',
        `<tr><td>${name}</td><td><b>${pct(r.top1)}</b></td><td>${pct(r.top3)}</td><td>${pct(r.silent)}</td><td>${r.vocab}</td></tr>`,
      );
    }
    $('#bench-state').textContent = `${cards.length} cartes, mesuré à l’instant`;
    btn.disabled = false;
  });
</script>
