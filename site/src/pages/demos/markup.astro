---
import '@trieur/core/trieur.css';
import DemoNav from '../../components/DemoNav.astro';
import Base from '../../layouts/Base.astro';
import ShortcutsDialog from '../../components/ShortcutsDialog.astro';
---

<Base title="Demo — the markup API">
  <section class="wrap" style="padding-top:44px">
    <DemoNav />
    <h1 style="margin:0 0 8px">In markup, without writing JS</h1>
    <p style="color:var(--dim);max-width:70ch;margin:0 0 26px">
      Zones and the card template are declared in HTML. The only JS left is the pile — and that comes from your data
      anyway. Add, change or remove a <code>&lt;trieur-zone&gt;</code> mid-session: the stage follows <em>without</em>
      starting over, the current pile and the undo history survive.
    </p>

    <p style="margin:0 0 20px">
      <button class="btn" id="add">Add an “archive” zone</button>
      <button class="btn" id="recolor">Recolour “dev”</button>
      <button class="btn" id="drop">Remove the last zone</button>
    </p>

    <div class="demo" style="margin-bottom:26px">
      <trieur-deck id="sorter" layout="voronoi" threshold="80" touch-preview="false">
        <trieur-zone value="dev" key="a" icon="⌘" color="#4a54f2">dev</trieur-zone>
        <trieur-zone value="ai" icon="◑" color="#8b5cf6">ai</trieur-zone>
        <trieur-zone value="home" icon="⌂" color="#f59e0b">home</trieur-zone>
        <trieur-zone></trieur-zone>
        <trieur-zone value="to read" icon="▤" color="#64748b">to read</trieur-zone>

        <template data-card>
          <div class="link">
            <span class="host" data-field="host"></span>
            <h4 data-field="title"></h4>
            <p data-field="excerpt"></p>
          </div>
        </template>
      </trieur-deck>
    </div>

    <pre><code>{`<trieur-deck id="sorter" layout="voronoi" threshold="80" multi
             tap-zones="false" touch-preview="false">
  <trieur-zone value="dev" key="a" icon="⌘" color="#4a54f2">dev</trieur-zone>
  <trieur-zone value="ai" icon="◑">ai</trieur-zone>
  <trieur-zone></trieur-zone><!-- free zone: dropping fires trieur:assign -->

  <template data-card>
    <div class="link">
      <span class="host" data-field="host"></span>
      <h4 data-field="title"></h4>
      <img data-field="image" data-attr="src" alt="" />
    </div>
  </template>
</trieur-deck>

<script type="module">
  import '@trieur/core/element';
  sorter.items = links;                    // JS always wins over markup
  sorter.addEventListener('trieur:sort', (e) => console.log(e.detail.item, e.detail.zones));
</script>`}</code></pre>

    <p class="note" style="max-width:70ch">
      No shadow DOM, deliberately: you draw the cards, so your styles have to reach them. The stage lives in a child of
      the custom element, so the library can rewrite its container without erasing the
      <code>&lt;trieur-zone&gt;</code> elements that are its configuration.
    </p>
  </section>
  <ShortcutsDialog />
</Base>

<script>
  import '@trieur/core/element';
  import { shuffled } from '../../data/links';
  import { shortcutsButton } from '../../scripts/shortcuts';

  const deck = document.querySelector('trieur-deck')!;
  deck.items = shuffled(5).slice(0, 20);
  // the element builds its deck on connect, so the bar exists by the next frame
  requestAnimationFrame(() => deck.deck && shortcutsButton(deck.deck));

  const zone = (attrs: Record<string, string>, label: string) => {
    const el = document.createElement('trieur-zone');
    for (const [k, v] of Object.entries(attrs)) el.setAttribute(k, v);
    el.textContent = label;
    return el;
  };

  document.querySelector('#add')!.addEventListener('click', () => {
    deck.append(zone({ value: 'archive', icon: '⌸', color: '#10b981' }, 'archive'));
  });
  document.querySelector('#recolor')!.addEventListener('click', () => {
    const dev = deck.querySelector('trieur-zone[value="dev"]');
    dev?.setAttribute('color', ['#4a54f2', '#ec4899', '#10b981'][Math.floor(Math.random() * 3)]!);
  });
  document.querySelector('#drop')!.addEventListener('click', () => {
    [...deck.querySelectorAll('trieur-zone')].pop()?.remove();
  });
</script>
