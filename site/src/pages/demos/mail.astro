---
import '@trieur/core/trieur.css';
import DemoNav from '../../components/DemoNav.astro';
import Base from '../../layouts/Base.astro';
import ShortcutsDialog from '../../components/ShortcutsDialog.astro';
---

<Base title="Demo — an inbox, triaged">
  <section class="wrap" style="padding-top:44px">
    <DemoNav />
    <h1 style="margin:0 0 8px">An inbox, triaged</h1>
    <p style="color:var(--dim);max-width:70ch;margin:0 0 26px">
      A mailbox is the hardest thing this library gets asked to do, because half the zones are
      <em>folders</em> — clients, finance, team — and the other half are <em>verbs</em>: reply, spam, delete. The
      gesture is the same; what happens afterwards is not, and that difference lives entirely in the host. Read a
      message, then file it or act on it, and watch the model start guessing where the next one goes.
    </p>

    <div class="demo demo-side">
      <div id="sorter"></div>
      <div>
        <div class="panel">
          <h3>Suggestion</h3>
          <p id="guess" style="margin:0 0 6px;color:var(--dim)">
            File a few and the model starts answering. <kbd>↵</kbd> accepts it.
          </p>
          <p class="why" id="why"></p>
        </div>
        <div class="panel">
          <h3>Mailbox</h3>
          <div class="kv"><span>inbox</span><b id="left">—</b></div>
          <div class="kv"><span>filed</span><b id="filed">0</b></div>
          <div class="kv"><span>replied</span><b id="replied">0</b></div>
          <div class="kv"><span>spam · deleted</span><b id="killed">0 · 0</b></div>
        </div>
        <div class="panel" id="compose-panel" hidden>
          <h3>Reply</h3>
          <p id="compose-to" style="margin:0 0 8px;color:var(--dim);font-size:12.5px"></p>
          <textarea id="compose" rows="5" spellcheck="false"></textarea>
          <div style="display:flex;gap:8px;margin-top:8px">
            <button class="btn" id="send">Send</button>
            <button class="btn" id="cancel">Cancel</button>
          </div>
        </div>
        <div class="panel">
          <h3>Log</h3>
          <ol id="log" class="mlog"></ol>
        </div>
      </div>
    </div>

    <div class="prose" style="margin-top:60px">
      <h2>Folders and verbs, in the same ring</h2>
      <p>
        <code>onSort</code> receives the message and the zone; everything after that is the host's business. Four of
        these zones move a message, three do something to it, and one of the three opens a compose box and refuses the
        filing until it is sent — the deck accepts that, because a rejected <code>onSort</code> brings the card home.
      </p>
      <pre><code>{`onSort: async (mail, zone) => {
  if (zone.id === 'reply') {
    const sent = await compose(mail);      // opens the panel, resolves on send
    if (!sent) throw new Error('cancelled'); // the card comes back to the pile
    return;
  }
  if (zone.id === 'trash') return api.trash(mail.id);
  if (zone.id === 'spam')  return api.spam(mail.id);   // and it teaches the filter
  return api.move(mail.id, zone.id);
}`}</code></pre>
      <p>
        The model sees the envelope — sender, domain, subject, whether anything is attached — and never the folder the
        message ended up in until you put it there. Two newsletters from the same domain teach it the domain; a client
        who writes about invoices teaches it that <em>invoice</em> beats <em>the person</em>. That is the whole
        argument for learning from the gesture: nobody writes those rules down, and everybody has them.
      </p>
      <h2>Reading, inside a card</h2>
      <p>
        The body is in the card, and the card is a normal piece of DOM: the sender is a <code>mailto:</code> link, the
        attachments are buttons, and <em>Read the rest</em> expands the message without ending the drag. That works
        because the gesture only takes the pointer once it has actually moved — a tap on a link stays a tap on a link.
      </p>
    </div>
  </section>
  <ShortcutsDialog />
</Base>

<style is:global>
  .mail { padding: 0; display: flex; flex-direction: column; height: 100%; }
  .mail .head { display: flex; gap: 10px; align-items: center; padding: 14px 16px 10px; }
  .mail .avatar {
    width: 34px;
    height: 34px;
    flex: none;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-size: 12.5px;
    font-weight: 600;
    color: #fff;
    letter-spacing: 0.02em;
  }
  .mail .who { min-width: 0; flex: 1; }
  .mail .who b { display: block; font-size: 13.5px; font-weight: 600; }
  .mail .who a {
    display: block;
    color: var(--dim);
    font-size: 11.5px;
    font-family: var(--mono);
    text-decoration: none;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .mail .who a:hover { color: var(--accent); }
  .mail .at { color: var(--dim); font-size: 11.5px; white-space: nowrap; }
  .mail h4 { margin: 0; padding: 0 16px 8px; font-size: 15.5px; line-height: 1.25; }
  .mail .body { padding: 0 16px; font-size: 13px; color: var(--dim); line-height: 1.5; overflow: hidden; }
  .mail .body p { margin: 0 0 8px; }
  .mail .more {
    align-self: flex-start;
    margin: 2px 16px 0;
    padding: 0;
    border: 0;
    background: none;
    color: var(--accent);
    font: inherit;
    font-size: 12px;
    cursor: pointer;
  }
  .mail .att { display: flex; flex-wrap: wrap; gap: 6px; margin-top: auto; padding: 10px 16px 14px; }
  .mail .att button {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 9px;
    border: 1px solid var(--line);
    border-radius: 7px;
    background: none;
    color: var(--dim);
    font: inherit;
    font-size: 11px;
    font-family: var(--mono);
    cursor: pointer;
  }
  .mail .att button:hover { border-color: var(--accent); color: var(--accent); }
  .mail .unread { position: absolute; top: 14px; right: 14px; width: 8px; height: 8px; border-radius: 50%; background: var(--accent); }

  /* the three zones that are verbs rather than folders wear it: dashed, like a hole in a wall */
  .demo .tr-zone[data-id='reply'],
  .demo .tr-zone[data-id='spam'],
  .demo .tr-zone[data-id='trash'] { border-style: dashed; }
  .demo .tr-seg[data-index='4'],
  .demo .tr-seg[data-index='6'],
  .demo .tr-seg[data-index='7'] { stroke-dasharray: 2 3; }

  #compose { width: 100%; font: inherit; font-size: 13px; padding: 8px 10px; border: 1px solid var(--line); border-radius: 8px; background: var(--bg); color: var(--ink); resize: vertical; }
  .mlog { margin: 0; padding: 0; list-style: none; font-size: 12.5px; }
  .mlog li { display: flex; gap: 8px; padding: 4px 0; border-bottom: 1px dotted var(--line); color: var(--dim); }
  .mlog li b { color: var(--ink); font-weight: 600; }
  .mlog li i { margin-left: auto; font-style: normal; font-family: var(--mono); font-size: 11px; }
</style>

<script>
  import { Deck } from '@trieur/core';
  import { createRecommender } from '@trieur/learn';
  import { actions, folders, mails, meta, type Mail } from '../../data/mail';
  import { shortcutsButton } from '../../scripts/shortcuts';

  const $ = <T extends HTMLElement = HTMLElement>(s: string) => document.querySelector<T>(s)!;
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  const hue = (s: string) => `hsl(${[...s].reduce((a, c) => a + c.charCodeAt(0), 0) % 360} 52% 46%)`;
  const initials = (s: string) =>
    s
      .split(/\s+/)
      .slice(0, 2)
      .map((w) => w[0])
      .join('')
      .toUpperCase();

  const tally = { filed: 0, replied: 0, spam: 0, trash: 0 };

  /** The card *is* the mail reader: a header, the subject, the body, its attachments. */
  function renderCard(m: Mail, el: HTMLElement) {
    el.innerHTML = `
      <div class="mail">
        ${m.unread ? '<span class="unread" aria-label="unread"></span>' : ''}
        <div class="head">
          <span class="avatar" style="background:${hue(m.from)}">${esc(initials(m.from))}</span>
          <span class="who">
            <b>${esc(m.from)}</b>
            <a href="mailto:${esc(m.email)}">${esc(m.email)}</a>
          </span>
          <span class="at">${esc(m.at)}</span>
        </div>
        <h4>${esc(m.subject)}</h4>
        <div class="body">${m.body.slice(0, 1).map((p) => `<p>${esc(p)}</p>`).join('')}</div>
        ${m.body.length > 1 ? '<button class="more" type="button">Read the rest ↓</button>' : ''}
        ${
          m.attachments
            ? `<div class="att">${m.attachments
                .map((a) => `<button type="button">▤ ${esc(a.name)} <span>${esc(a.size)}</span></button>`)
                .join('')}</div>`
            : ''
        }
      </div>`;
    // interactive inside a draggable card: the gesture only takes over once it has moved
    el.querySelector('.more')?.addEventListener('click', (e) => {
      e.stopPropagation();
      el.querySelector('.body')!.innerHTML = m.body.map((p) => `<p>${esc(p)}</p>`).join('');
      (e.currentTarget as HTMLElement).remove();
    });
  }

  /** Reply: the compose panel, and a promise that resolves when it is sent or dropped. */
  const compose = (m: Mail) =>
    new Promise<boolean>((resolve) => {
      const panel = $('#compose-panel');
      panel.hidden = false;
      $('#compose-to').textContent = `To ${m.from} · Re: ${m.subject}`;
      const box = $<HTMLTextAreaElement>('#compose');
      box.value = `Hi ${m.from.split(' ')[0]},\n\n\n\n— sent from a card sorter`;
      box.focus();
      box.setSelectionRange(box.value.indexOf('\n\n') + 2, box.value.indexOf('\n\n') + 2);
      const done = (sent: boolean) => {
        panel.hidden = true;
        $('#send').removeEventListener('click', ok);
        $('#cancel').removeEventListener('click', no);
        resolve(sent);
      };
      const ok = () => done(true);
      const no = () => done(false);
      $('#send').addEventListener('click', ok);
      $('#cancel').addEventListener('click', no);
    });

  const log = (verb: string, m: Mail, where: string) => {
    const li = document.createElement('li');
    li.innerHTML = `<b>${esc(verb)}</b> ${esc(m.subject.slice(0, 26))}… <i>${esc(where)}</i>`;
    $('#log').prepend(li);
    while ($('#log').children.length > 8) $('#log').lastElementChild!.remove();
  };

  // the deck removes the card *after* onSort resolves, so the count is read from the event
  const report = () => {
    $('#left').textContent = String(deck.items.length);
    $('#filed').textContent = String(tally.filed);
    $('#replied').textContent = String(tally.replied);
    $('#killed').textContent = `${tally.spam} · ${tally.trash}`;
  };

  const brain = createRecommender({ key: 'demo-mail' });

  const deck = new Deck<Mail>($('#sorter'), {
    items: [...mails],
    zones: folders,
    meta,
    renderCard,
    advisor: brain,
    minConfidence: 0.4,
    keys: 'asdfghjk',
    onSort: async (mail, zone) => {
      if (zone.id === 'reply') {
        // the compose box decides: a cancelled reply rejects, and the card comes home
        const sent = await compose(mail);
        if (!sent) throw new Error('reply cancelled');
        tally.replied++;
        log('Replied to', mail, 'sent');
      } else if (zone.id === 'spam') {
        tally.spam++;
        log('Spam', mail, mail.email.split('@')[1] ?? '');
      } else if (zone.id === 'trash') {
        tally.trash++;
        log('Deleted', mail, 'trash');
      } else {
        tally.filed++;
        log('Filed', mail, zone.label ?? zone.id);
      }
      report();
    },
    onUndo: (mail, zone) => {
      const key = zone.id === 'reply' ? 'replied' : zone.id === 'spam' ? 'spam' : zone.id === 'trash' ? 'trash' : 'filed';
      tally[key as keyof typeof tally] = Math.max(0, tally[key as keyof typeof tally] - 1);
      log('Undid', mail, zone.label ?? zone.id);
      report();
    },
  });

  for (const ev of ['trieur:sort', 'trieur:undo', 'trieur:skip']) deck.root.addEventListener(ev, report);
  deck.root.addEventListener('trieur:suggest', (e) => {
    const { id, score, why } = (e as CustomEvent).detail;
    const zone = folders.find((f) => f.id === id);
    $('#guess').innerHTML = `<b>${esc(zone?.label ?? id)}</b> · ${(score * 100).toFixed(0)}% ${
      actions.has(id) ? '<span style="color:var(--dim)">(an action, not a folder)</span>' : ''
    }`;
    $('#why').textContent = why.slice(0, 6).join(' · ');
  });
  deck.root.addEventListener('trieur:empty', () => {
    $('#guess').textContent = 'Inbox zero. The model kept what it learned.';
  });

  report();
  shortcutsButton(deck);
  deck.focus();
</script>
