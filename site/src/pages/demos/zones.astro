---
import '@trieur/core/trieur.css';
import DemoNav from '../../components/DemoNav.astro';
import Base from '../../layouts/Base.astro';
import ShortcutsDialog from '../../components/ShortcutsDialog.astro';
import { url } from '../../lib/url';

// A small diagram beats a sentence for "what does this layout look like".
const PREVIEW: Record<string, string> = {
  auto: `<rect x="3" y="7" width="24" height="20" rx="3"/><rect x="31" y="4" width="14" height="26" rx="3"/>`,
  circle: `<ellipse cx="24" cy="17" rx="18" ry="11"/><circle cx="24" cy="6" r="2.6" fill="currentColor"/><circle cx="39" cy="12" r="2.6" fill="currentColor"/><circle cx="39" cy="22" r="2.6" fill="currentColor"/><circle cx="24" cy="28" r="2.6" fill="currentColor"/><circle cx="9" cy="22" r="2.6" fill="currentColor"/><circle cx="9" cy="12" r="2.6" fill="currentColor"/>`,
  radial: `<circle cx="24" cy="17" r="14"/><circle cx="24" cy="17" r="6"/><path d="M24 3v-0M24 3 24 11M38 17h-8M31.5 27.5 26 22M16.5 27.5 22 22M10 17h8M16.5 6.5 22 12M31.5 6.5 26 12"/>`,
  voronoi: `<path d="M4 4h16l6 8-8 8H4z"/><path d="M20 4h24v12l-18 -4z"/><path d="M4 20h14l10 10H4z"/><path d="M18 20l8-8 18 4v14H28z"/>`,
  grid: `<rect x="4" y="4" width="12" height="12" rx="2"/><rect x="18" y="4" width="12" height="12" rx="2"/><rect x="32" y="4" width="12" height="12" rx="2"/><rect x="4" y="18" width="18" height="12" rx="2"/><rect x="24" y="18" width="20" height="12" rx="2"/>`,
  dock: `<path d="M4 3v28M16 3v28M28 3v28M40 3v28" opacity=".45"/><rect x="6" y="22" width="8" height="8" rx="2" fill="currentColor"/><rect x="18" y="22" width="8" height="8" rx="2" fill="currentColor"/><rect x="30" y="22" width="8" height="8" rx="2" fill="currentColor"/>`,
};

const layouts = [
  ['auto', 'auto', 'A dock on a narrow stage that can hold one, a circle everywhere else. The default.'],
  ['circle', 'circle', 'Tiles on an ellipse that hugs the stage. Survives any number of zones.'],
  ['radial', 'radial', 'A true pie menu: equal wedges, the card in the hole. Past eight zones it grows a second ring.'],
  ['voronoi', 'mosaic', 'A golden-angle spiral, then Lloyd relaxation — an irregular tiling with cells of comparable size.'],
  ['grid', 'grid', 'Rectangles tiling the stage, no gaps and no leftover cell. Five zones give three over two.'],
  ['dock', 'dock', 'Zones along an edge, each owning a column. More than fit across wrap into a tray. The phone layout.'],
];
---

<Base title="Demo — zones and layouts">
  <section class="wrap" style="padding-top:44px">
    <DemoNav />
    <h1 style="margin:0 0 8px">Zones, your way</h1>
    <p style="color:var(--dim);max-width:70ch;margin:0 0 26px">
      A zone is an id, a label, a key, and whatever you want it to look like. Click any tile below to rename it, recolour
      it, give it an icon or change its key — then switch layouts and watch the regions follow. Nothing here is a
      special case: it is the same <code>zones</code> array and the same <code>layout</code> option you would pass.
    </p>

    <div class="layout-picker">
      {
        layouts.map(([id, name, blurb]) => (
          <button type="button" class="layout-opt" data-layout={id}>
            <svg viewBox="0 0 48 34" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
              <Fragment set:html={PREVIEW[id!]} />
            </svg>
            <b>{name}</b>
            <span>{blurb}</span>
          </button>
        ))
      }
    </div>

    <div class="demo demo-side" style="margin-top:22px">
      <div id="sorter"></div>
      <div>
        <div class="panel">
          <h3>Zones</h3>
          <p style="margin:0 0 10px;color:var(--dim)">Click a tile on the stage, or a row here, to edit it.</p>
          <ol id="zone-list" class="zone-list"></ol>
          <div class="presets">
            <span>how many</span>
            <button type="button" class="btn" data-n="4">4</button>
            <button type="button" class="btn" data-n="6">6</button>
            <button type="button" class="btn" data-n="10">10</button>
            <button type="button" class="btn" data-n="16">16</button>
          </div>
          <p style="margin:8px 0 0;color:var(--dim);font-size:12px">
            Ten or sixteen is where the radial menu grows its second and third ring — each one longer than the last, so
            it holds proportionally more.
          </p>
          <button class="btn" id="add-zone" style="margin-top:10px;font-size:13px">Add a zone</button>
        </div>
        <div class="panel">
          <h3>Chrome</h3>
          <label class="opt"><input type="checkbox" id="opt-segments" checked /> <span>regions</span></label>
          <label class="opt"><input type="checkbox" id="opt-keys" checked /> <span>key caps</span></label>
          <label class="opt"><input type="checkbox" id="opt-tiles" checked /> <span>tile boxes</span></label>
        </div>
        <div class="panel" id="shape" hidden>
          <h3>Shape</h3>
          <div id="shape-radial" hidden>
            <label class="opt slider"><span>sweep</span><input type="range" id="sweep" min="60" max="360" step="15" value="360" /><output>360°</output></label>
            <label class="opt slider"><span>start</span><input type="range" id="start" min="-180" max="180" step="15" value="-90" /><output>-90°</output></label>
            <label class="opt slider"><span>ring gap</span><input type="range" id="ring-gap" min="0" max="28" step="1" value="3" /><output>3px</output></label>
            <p style="margin:8px 0 0;color:var(--dim);font-size:12px">
              A half or a quarter is not decoration: it is what lets the menu sit against an edge, or beside a thumb,
              without wedges pointing off the screen.
            </p>
          </div>
          <div id="shape-dock" hidden>
            <label class="opt"><input type="checkbox" id="dock-split" /> <span>top and bottom</span></label>
            <label class="opt slider"><span>rows</span><input type="range" id="dock-rows" min="0" max="3" step="1" value="0" /><output>auto</output></label>
          </div>
        </div>
        <div class="panel">
          <h3>What you built</h3>
          <pre id="config" style="font-size:11.5px;padding:12px 14px;margin:0;white-space:pre-wrap"></pre>
        </div>
      </div>
    </div>

    <dialog id="editor" class="editor">
      <form method="dialog">
        <h3>Edit zone</h3>
        <label class="field"><span>name</span><input name="label" autocomplete="off" /></label>
        <label class="field"><span>key</span><input name="key" maxlength="1" autocomplete="off" /></label>
        <label class="field"><span>icon</span><input name="icon" maxlength="2" autocomplete="off" placeholder="emoji" /></label>
        <label class="field"><span>colour</span><input name="color" type="color" /></label>
        <menu>
          <button value="remove" class="btn" formnovalidate>Remove</button>
          <span style="flex:1"></span>
          <button value="cancel" class="btn" formnovalidate>Cancel</button>
          <button value="save" class="btn primary">Save</button>
        </menu>
      </form>
    </dialog>

    <div class="prose" style="margin-top:60px">
      <h2>Drawing a zone yourself</h2>
      <p>
        The default tile is a Finder-style folder: a chip filled with the zone's colour, or its emoji, or its image; a
        two-line label; the key at the foot. <code>renderZone</code> replaces it entirely — you get the zone and an
        empty element, and whatever you put in it is the tile.
      </p>
      <pre><code>{`new Deck(el, {
  zones,
  layout: 'radial',
  renderZone: (zone, el) => {
    // zone: { id, label, key, color, icon, image, index, empty, angle, pos, cell }
    el.style.setProperty('--tr-seg', zone.color);      // drives the region behind it too
    el.innerHTML = \`
      <span class="tr-glyph">\${zone.icon ?? ''}</span>
      <span class="tr-label">\${zone.label}</span>
      <kbd>\${zone.key}</kbd>\`;
  },
});`}</code></pre>
      <p>
        The class names are the library's own, so you inherit its states for free —
        <code>.tr-near</code>, <code>.tr-armed</code>, <code>.tr-suggest</code>, <code>.tr-picked</code> land on the
        element you filled. Or ignore them and style your own. See
        <a href={url('/docs/rendering/')}>rendering cards and zones</a>.
      </p>
    </div>
  </section>
  <ShortcutsDialog multi />
</Base>

<style>
  .layout-picker { display: grid; gap: 10px; grid-template-columns: repeat(auto-fit, minmax(178px, 1fr)); }
  .layout-opt {
    display: grid;
    grid-template-columns: 48px 1fr;
    grid-template-areas: 'icon name' 'icon blurb';
    align-items: center;
    gap: 2px 12px;
    text-align: left;
    padding: 12px 14px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--panel);
    color: inherit;
    font: inherit;
    cursor: pointer;
    transition: border-color 140ms, box-shadow 140ms;
  }
  .layout-opt svg { grid-area: icon; width: 48px; height: 34px; color: var(--dim); }
  .layout-opt b { grid-area: name; align-self: end; font-size: 14px; }
  .layout-opt span { grid-area: blurb; align-self: start; font-size: 12px; color: var(--dim); line-height: 1.4; }
  .layout-opt:hover { border-color: color-mix(in srgb, var(--accent) 45%, var(--line)); }
  .layout-opt[aria-pressed='true'] { border-color: var(--accent); box-shadow: 0 0 0 2px color-mix(in srgb, var(--accent) 16%, transparent); }
  .layout-opt[aria-pressed='true'] svg { color: var(--accent); }
  /* the blurb is a hint, not a paragraph: it must not push the row into three lines */
  @media (max-width: 700px) { .layout-opt span { display: none; } }

  .presets { display: flex; align-items: center; gap: 6px; margin-top: 10px; font-size: 13px; }
  .presets span { color: var(--dim); margin-right: auto; }
  .presets .btn { padding: 3px 9px; font-size: 12.5px; }
  .opt { display: flex; align-items: center; gap: 8px; padding: 4px 0; font-size: 13.5px; }
  .opt.slider { display: grid; grid-template-columns: 62px 1fr 44px; }
  .opt.slider input { width: 100%; accent-color: var(--accent); }
  .opt.slider output { text-align: right; font-family: var(--mono); font-size: 11.5px; color: var(--dim); }
  #shape[hidden], #shape-radial[hidden], #shape-dock[hidden] { display: none; }

  .editor { border: 1px solid var(--line); border-radius: 14px; padding: 20px 22px; background: var(--panel); color: var(--ink); min-width: 300px; }
  .editor::backdrop { background: rgba(10, 10, 18, 0.34); }
  .editor h3 { margin: 0 0 14px; font-size: 15px; }
  .editor .field { display: grid; grid-template-columns: 64px 1fr; align-items: center; gap: 10px; margin-bottom: 9px; font-size: 13px; }
  .editor .field span { color: var(--dim); }
  .editor input { font: inherit; padding: 5px 8px; border: 1px solid var(--line); border-radius: 7px; background: var(--bg); color: var(--ink); }
  .editor input[type='color'] { padding: 2px; height: 30px; }
  .editor menu { display: flex; gap: 8px; margin: 16px 0 0; padding: 0; }
</style>

<script>
  import { Deck, dockLayout, radialLayout } from '@trieur/core';
  import { shuffled, type Link } from '../../data/links';
  import { renderCard } from '../../scripts/card';
  import { shortcutsButton } from '../../scripts/shortcuts';

  const $ = <T extends Element = HTMLElement>(s: string) => document.querySelector<T>(s)!;

  type Z = { id: string; label: string; key?: string; icon?: string; color?: string };
  // a pool deep enough to push the radial menu into its second and third ring
  const POOL: Z[] = [
    { id: 'dev', label: 'dev', icon: '⌘', color: '#4a54f2' },
    { id: 'ai', label: 'ai', icon: '◑', color: '#8b5cf6' },
    { id: 'design', label: 'design', icon: '◈', color: '#ec4899' },
    { id: 'home', label: 'home', icon: '⌂', color: '#f59e0b' },
    { id: 'watch', label: 'watch', icon: '◎', color: '#10b981' },
    { id: 'to read', label: 'to read', icon: '▤', color: '#64748b' },
    { id: 'rust', label: 'rust', icon: '⚙', color: '#b45309' },
    { id: 'papers', label: 'papers', icon: '✎', color: '#0ea5e9' },
    { id: 'music', label: 'music', icon: '♪', color: '#d946ef' },
    { id: 'travel', label: 'travel', icon: '✈', color: '#14b8a6' },
    { id: 'food', label: 'food', icon: '✿', color: '#f43f5e' },
    { id: 'money', label: 'money', icon: '◈', color: '#22c55e' },
    { id: 'games', label: 'games', icon: '◉', color: '#6366f1' },
    { id: 'shop', label: 'shop', icon: '▣', color: '#eab308' },
    { id: 'health', label: 'health', icon: '✚', color: '#ef4444' },
    { id: 'archive', label: 'archive', icon: '▦', color: '#94a3b8' },
  ];
  let zones: Z[] = POOL.slice(0, 6).map((z) => ({ ...z }));
  let layout = 'auto';

  const deck = new Deck<Link>($('#sorter'), {
    items: shuffled(4),
    zones,
    layout,
    multi: true,
    multiPad: 'dynamic',
    renderCard,
    onSort: () => {},
  });

  // --- layout picker -----------------------------------------------------------
  const num = (id: string) => Number($<HTMLInputElement>(id).value);
  const rad = (deg: number) => (deg * Math.PI) / 180;

  /** The layout, with whatever shape controls apply to it. */
  const shaped = () => {
    if (layout === 'radial') {
      return radialLayout({ sweep: rad(num('#sweep')), start: rad(num('#start')), ringGap: num('#ring-gap') });
    }
    if (layout === 'dock') {
      const rows = num('#dock-rows');
      return dockLayout({ split: $<HTMLInputElement>('#dock-split').checked, ...(rows ? { rows } : {}) });
    }
    return layout as 'circle';
  };

  const pickLayout = (name: string) => {
    layout = name;
    for (const b of document.querySelectorAll<HTMLElement>('.layout-opt')) {
      b.setAttribute('aria-pressed', String(b.dataset.layout === name));
    }
    // a radial menu wants its hole small, or the ring has nothing left to live in
    deck.root.style.setProperty('--tr-card-w', name === 'radial' ? '190px' : '260px');
    deck.root.style.setProperty('--tr-card-h', name === 'radial' ? '210px' : '300px');
    $('#shape').hidden = name !== 'radial' && name !== 'dock';
    $('#shape-radial').hidden = name !== 'radial';
    $('#shape-dock').hidden = name !== 'dock';
    deck.setOptions({ layout: shaped() });
    sync();
  };

  // every shape control does the same thing: rebuild the layout and relabel its readout
  for (const el of document.querySelectorAll<HTMLInputElement>('#shape input')) {
    el.addEventListener('input', () => {
      const out = el.parentElement?.querySelector('output');
      if (out) out.textContent = el.id === 'dock-rows' ? (el.value === '0' ? 'auto' : el.value) : `${el.value}${el.id === 'ring-gap' ? 'px' : '°'}`;
      deck.setOptions({ layout: shaped() });
      sync();
    });
  }
  for (const b of document.querySelectorAll<HTMLElement>('.layout-opt')) {
    b.addEventListener('click', () => pickLayout(b.dataset.layout!));
  }
  pickLayout('auto');

  // --- chrome toggles ----------------------------------------------------------
  $('#opt-segments').addEventListener('change', (e) => {
    deck.setOptions({ segments: (e.target as HTMLInputElement).checked });
    sync();
  });
  $('#opt-keys').addEventListener('change', (e) => {
    deck.root.classList.toggle('no-keys', !(e.target as HTMLInputElement).checked);
  });
  $('#opt-tiles').addEventListener('change', (e) => {
    deck.root.classList.toggle('no-tiles', !(e.target as HTMLInputElement).checked);
  });

  // --- the editor --------------------------------------------------------------
  const dialog = $<HTMLDialogElement>('#editor');
  let editing = -1;

  function open(index: number) {
    editing = index;
    const z = zones[index]!;
    const form = dialog.querySelector('form')!;
    (form.elements.namedItem('label') as HTMLInputElement).value = z.label;
    (form.elements.namedItem('key') as HTMLInputElement).value = z.key ?? '';
    (form.elements.namedItem('icon') as HTMLInputElement).value = z.icon ?? '';
    (form.elements.namedItem('color') as HTMLInputElement).value = z.color ?? '#4a54f2';
    dialog.showModal();
  }

  dialog.addEventListener('close', () => {
    if (editing < 0) return;
    const form = dialog.querySelector('form')!;
    const value = dialog.returnValue;
    if (value === 'remove') zones = zones.filter((_, i) => i !== editing);
    else if (value === 'save') {
      const label = (form.elements.namedItem('label') as HTMLInputElement).value.trim() || zones[editing]!.label;
      zones[editing] = {
        // the id is what the model learned against, so renaming a zone keeps it
        id: zones[editing]!.id,
        label,
        key: (form.elements.namedItem('key') as HTMLInputElement).value.trim().toLowerCase() || undefined,
        icon: (form.elements.namedItem('icon') as HTMLInputElement).value.trim() || undefined,
        color: (form.elements.namedItem('color') as HTMLInputElement).value,
      };
    }
    editing = -1;
    apply();
  });

  // a tile click while multi mode is off is the host's to use
  deck.root.addEventListener('click', (e) => {
    const tile = (e.target as Element).closest<HTMLElement>('.tr-zone');
    if (tile && !deck.multi) open(Number(tile.dataset.index));
  });

  for (const b of document.querySelectorAll<HTMLElement>('.presets button')) {
    b.addEventListener('click', () => {
      zones = POOL.slice(0, Number(b.dataset.n)).map((z) => ({ ...z }));
      apply();
    });
  }

  $('#add-zone').addEventListener('click', () => {
    zones = [...zones, { id: `zone ${zones.length + 1}`, label: `zone ${zones.length + 1}`, color: '#94a3b8' }];
    apply();
    open(zones.length - 1);
  });

  function apply() {
    deck.setZones(zones);
    sync();
  }

  function sync() {
    $('#zone-list').innerHTML = zones
      .map(
        (z, i) =>
          `<li data-i="${i}"><i style="background:${z.color ?? '#94a3b8'}"></i><b>${z.label}</b>${
            z.key ? `<kbd style="margin-left:auto">${z.key}</kbd>` : '<span style="margin-left:auto"></span>'
          }</li>`,
      )
      .join('');
    for (const li of document.querySelectorAll<HTMLElement>('.zone-list li')) {
      li.addEventListener('click', () => open(Number(li.dataset.i)));
    }
    const shape =
      layout === 'radial'
        ? `radialLayout({ sweep: ${num('#sweep')}°, start: ${num('#start')}°, ringGap: ${num('#ring-gap')} })`
        : layout === 'dock'
          ? `dockLayout({ split: ${$<HTMLInputElement>('#dock-split').checked}${num('#dock-rows') ? `, rows: ${num('#dock-rows')}` : ''} })`
          : `'${layout}'`;
    $('#config').textContent =
      `layout: ${shape},\nsegments: ${deck.options.segments !== false},\nzones: [\n` +
      zones
        .map((z) => `  { id: '${z.id}'${z.key ? `, key: '${z.key}'` : ''}${z.icon ? `, icon: '${z.icon}'` : ''}${z.color ? `, color: '${z.color}'` : ''} },`)
        .join('\n') +
      '\n]';
  }

  sync();
  shortcutsButton(deck);
  deck.focus();
</script>

<style is:global>
  /* the two chrome toggles, done the way a host would: plain CSS over stable class names */
  .no-keys .tr-zone kbd { display: none; }
  .no-tiles .tr-zone { background: none; border-color: transparent; box-shadow: none; }

  /* global, not scoped: these rows are built at runtime, and Astro's scoping only reaches
     elements that were in the template at build time */
  .zone-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; }
  .zone-list li { display: flex; align-items: center; gap: 8px; padding: 5px 8px; border: 1px solid var(--line); border-radius: 8px; cursor: pointer; }
  .zone-list li:hover { border-color: var(--accent); }
  .zone-list i { width: 16px; height: 16px; border-radius: 5px; flex: none; }
  .zone-list b { font-weight: 500; font-size: 13.5px; }
</style>
