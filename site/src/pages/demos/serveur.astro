---
import '@trieur/core/trieur.css';
import DemoNav from '../../components/DemoNav.astro';
import Base from '../../layouts/Base.astro';
---

<Base title="Démo — léger et complet">
  <section class="wrap" style="padding-top:44px">
    <DemoNav />
    <h1 style="margin:0 0 8px">Léger, complet, hors ligne</h1>
    <p style="color:var(--dim);max-width:70ch;margin:0 0 26px">
      Ici le deck parle à un serveur trieur <em>simulé dans cet onglet</em> — mêmes routes, même déduplication par
      identifiant d'événement que <code>@trieur/server</code>. Coupe le réseau et continue de trier&nbsp;: le modèle
      local répond toujours, la file d'événements se remplit, et tout repart au rétablissement. Rien n'est perdu, rien
      n'est appris deux fois.
    </p>

    <p style="margin:0 0 20px">
      <button class="btn" id="offline">Couper le réseau</button>
      <button class="btn" id="flush">Envoyer maintenant</button>
      <button class="btn" id="device">Simuler un nouvel appareil</button>
    </p>

    <div class="demo demo-side">
      <div id="deck"></div>
      <div>
        <div class="panel">
          <h3>Client</h3>
          <div class="kv"><span>état</span><b id="net">en ligne</b></div>
          <div class="kv"><span>appris localement</span><b id="local">0</b></div>
          <div class="kv"><span>en attente d'envoi</span><b id="pending">0</b></div>
        </div>
        <div class="panel">
          <h3>Serveur</h3>
          <div class="kv"><span>événements reçus</span><b id="received">0</b></div>
          <div class="kv"><span>version du modèle</span><b id="version">0</b></div>
        </div>
        <div class="panel">
          <h3>Échanges</h3>
          <ol id="log" style="margin:0;padding:0;list-style:none;font-family:var(--mono);font-size:11.5px;color:var(--dim)"></ol>
        </div>
      </div>
    </div>

    <div class="prose" style="margin-top:60px">
      <h2>Ce que le serveur change, et ce qu'il ne change pas</h2>
      <p>
        Ce qu'il ne change pas&nbsp;: la boucle du geste. La carte est déjà sous le doigt quand il faut proposer une
        zone — le local répond, toujours. Le serveur n'est interrogé que lorsque le local <em>n'a rien à dire</em>, avec
        un délai maximum court, et son silence n'empêche jamais de trier.
      </p>
      <p>Ce qu'il change&nbsp;:</p>
      <ul>
        <li><b>Il garde les événements</b>, pas seulement le modèle — donc on peut tout rejouer après avoir changé d'extracteur de traits ou de modèle.</li>
        <li><b>Il démarre à chaud</b> un appareil neuf (bouton ci-dessus) : premier lancement, le modèle est déjà là.</li>
        <li><b>Il fait tourner ce que l'onglet ne peut pas</b> : les embeddings, qui rapprochent deux cartes ne partageant aucun mot.</li>
      </ul>
      <pre><code>{`// mode léger — rien ne sort du navigateur
const brain = createRecommender({ key: 'liens' });

// mode complet — la seule différence
const brain = createRecommender({
  key: 'liens',
  server: { url: 'https://trieur.chez-moi.fr', token: '…' },
});`}</code></pre>
    </div>
  </section>
</Base>

<script>
  import { Deck } from '@trieur/core';
  import { HybridRecommender } from '@trieur/learn';
  import { meta, shuffled, zones, type Lien } from '../../data/liens';
  import { renderCard } from '../../scripts/card';
  import { mockServer } from '../../scripts/mock-server';

  const $ = <T extends Element = HTMLElement>(s: string) => document.querySelector<T>(s)!;
  const server = mockServer();

  const make = (key: string) =>
    new HybridRecommender({
      key,
      deck: 'demo',
      saveDelay: 0,
      batch: 4,
      pushDelay: 1500,
      server: { url: 'https://exemple', fetch: server.fetch },
    });

  let brain = make('demo-serveur');
  const deck = new Deck<Lien>($('#deck'), { items: shuffled(13), zones, meta, renderCard, advisor: brain });

  async function refresh() {
    $('#net').textContent = server.offline ? 'hors ligne' : 'en ligne';
    $('#pending').textContent = String(brain.pending);
    $('#local').textContent = String((await brain.stats()).examples);
    $('#received').textContent = String(server.events.length);
    $('#version').textContent = String(server.version);
    $('#log').innerHTML = server.log.map((l) => `<li>${l}</li>`).join('');
  }
  server.onchange = () => void refresh();
  for (const ev of ['trieur:sort', 'trieur:undo']) deck.root.addEventListener(ev, () => void refresh());
  setInterval(() => void refresh(), 700);

  $('#offline').addEventListener('click', () => {
    server.offline = !server.offline;
    $('#offline').textContent = server.offline ? 'Rétablir le réseau' : 'Couper le réseau';
    if (!server.offline) void brain.flush();
    void refresh();
  });

  $('#flush').addEventListener('click', () => void brain.flush());

  // Nouvel appareil : un modèle local vide, qui va chercher celui du serveur au démarrage.
  $('#device').addEventListener('click', async () => {
    await brain.destroy();
    brain = make(`appareil-${Date.now()}`);
    await brain.ready();
    deck.setOptions({ advisor: brain });
    void refresh();
  });
</script>
