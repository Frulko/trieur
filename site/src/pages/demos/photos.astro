---
import '@trieur/core/trieur.css';
import DemoNav from '../../components/DemoNav.astro';
import Shortcuts from '../../components/Shortcuts.astro';
import Base from '../../layouts/Base.astro';
import ShortcutsDialog from '../../components/ShortcutsDialog.astro';
---

<Base title="Demo — sorting photographs">
  <section class="wrap" style="padding-top:44px">
    <DemoNav />
    <h1 style="margin:0 0 8px">A pile of photographs</h1>
    <p style="color:var(--dim);max-width:70ch;margin:0 0 26px">
      Same library, nothing in common with the link demo: the card is a full-bleed image with a metadata strip, the
      zones are albums, and the model watches the camera, the lens and the place instead of a domain and some tags.
      <code>renderCard</code> is where all of that lives — the deck never learns what a photograph is.
    </p>

    <div class="demo demo-side">
      <div id="sorter"></div>
      <div>
        <div class="panel">
          <h3>Metadata</h3>
          <div id="exif"></div>
        </div>
        <div class="panel">
          <h3>What the model watches</h3>
          <pre id="meta" style="font-size:11.5px;padding:12px 14px;margin:0;white-space:pre-wrap"></pre>
        </div>
        <Shortcuts title="Gestures" />
      </div>
    </div>

    <div class="prose" style="margin-top:60px">
      <h2>The card is yours</h2>
      <pre><code>{`new Deck(el, {
  items: photos,
  zones: albums,
  meta: (p) => ({ author: p.author, camera: p.exif.camera, place: p.exif.place, tag: [...] }),
  renderCard: (photo, el) => {
    el.innerHTML = \`
      <img src="\${photo.src}" alt="" />
      <footer>
        <b>\${photo.author}</b>
        <span>\${photo.exif.camera} · \${photo.exif.lens}</span>
      </footer>\`;
  },
  onSort: (photo, album) => api.move(photo.id, album.id),
});`}</code></pre>
      <p class="note">
        The photographs come from <a href="https://picsum.photos">Lorem Picsum</a>, which serves Unsplash images — the
        author and the dimensions are real. The EXIF is <b>sample data</b>, generated from the photo id so the demo
        stays stable. Putting invented shutter speeds on someone's photograph and calling it EXIF would be a lie, even
        in a demo.
      </p>
    </div>
  </section>
  <ShortcutsDialog />
</Base>

<style is:global>
  .demo.photos { --tr-card-w: 300px; --tr-card-h: 420px; }
  .shot { position: relative; height: 100%; display: flex; flex-direction: column; }
  .shot img { width: 100%; flex: 1; object-fit: cover; background: color-mix(in srgb, currentColor 8%, transparent); }
  .shot footer { padding: 12px 14px; display: grid; gap: 3px; }
  .shot b { font-size: 14px; }
  .shot span { font-family: var(--mono); font-size: 11px; color: var(--dim); }
  .exif-row { display: flex; justify-content: space-between; gap: 10px; padding: 4px 0; border-bottom: 1px dotted var(--line); font-size: 13px; }
  .exif-row span { color: var(--dim); }
  .exif-row b { font-family: var(--mono); font-weight: 500; font-size: 12px; }
</style>

<script>
  import { Deck } from '@trieur/core';
  import { createRecommender } from '@trieur/learn';
  import { albums, meta, photos, type Photo } from '../../data/photos';
  import { deckGui } from '../../scripts/gui';
  import { shortcutsButton } from '../../scripts/shortcuts';

  const $ = <T extends Element = HTMLElement>(s: string) => document.querySelector<T>(s)!;
  $('#sorter').closest('.demo')!.classList.add('photos');

  const deck = new Deck<Photo>($('#sorter'), {
    items: [...photos],
    zones: albums,
    layout: 'circle',
    meta,
    advisor: createRecommender({ key: 'demo-photos' }),
    renderCard: (p, el) => {
      el.innerHTML = `
        <div class="shot">
          <img src="${p.thumb}" alt="" loading="lazy" decoding="async" />
          <footer>
            <b>${p.author}</b>
            <span>${p.exif.camera} · ${p.exif.lens}</span>
          </footer>
        </div>`;
    },
    onSort: () => {},
  });

  const show = () => {
    const p = deck.current;
    if (!p) return void ($('#exif').innerHTML = '<p style="color:var(--dim);margin:0">Pile empty.</p>');
    const rows: Array<[string, string]> = [
      ['author', p.author],
      ['camera', p.exif.camera],
      ['lens', p.exif.lens],
      ['exposure', `${p.exif.shutter}s · ${p.exif.aperture} · ISO ${p.exif.iso}`],
      ['date', p.exif.date],
      ['place', p.exif.place],
      ['size', `${p.width} × ${p.height}`],
    ];
    $('#exif').innerHTML =
      rows.map(([k, v]) => `<div class="exif-row"><span>${k}</span><b>${v}</b></div>`).join('') +
      '<p style="color:var(--dim);font-size:12px;margin:10px 0 0">EXIF is sample data — see the note below.</p>';
    $('#meta').textContent = JSON.stringify(meta(p), null, 1);
  };
  for (const ev of ['trieur:sort', 'trieur:undo', 'trieur:skip']) deck.root.addEventListener(ev, show);
  show();
  deckGui(deck);
  shortcutsButton(deck);
  deck.focus();
</script>
