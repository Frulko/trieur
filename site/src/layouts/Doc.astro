---
import { url } from '../lib/url';
import Base from './Base.astro';

interface Props {
  frontmatter?: { title: string; description?: string };
  title?: string;
  description?: string;
}
const fm = Astro.props.frontmatter ?? (Astro.props as { title: string; description?: string });
const here = Astro.url.pathname.replace(/\/$/, '');

const sections = [
  {
    title: 'Understand',
    links: [
      { href: '/docs/', label: 'Overview' },
      { href: '/docs/start/', label: 'Getting started' },
      { href: '/docs/zones/', label: 'Zones and gesture' },
      { href: '/docs/rendering/', label: 'Rendering' },
      { href: '/docs/multi/', label: 'Several zones at once' },
      { href: '/docs/keyboard/', label: 'Keyboard and gestures' },
      { href: '/docs/throw/', label: 'The throw' },
      { href: '/docs/piles/', label: 'Two hands, two piles' },
      { href: '/docs/recipes/', label: 'Recipes' },
    ],
  },
  {
    title: 'The model',
    links: [
      { href: '/docs/model/', label: 'The ladder' },
      { href: '/docs/measure/', label: 'Measuring' },
    ],
  },
  {
    title: 'Integrate',
    links: [
      { href: '/docs/integration/', label: 'In an app' },
      { href: '/docs/server/', label: 'The server' },
      { href: '/docs/api/', label: 'Reference' },
    ],
  },
];
---

<Base title={`${fm.title} — trieur`} description={fm.description}>
  <div class="wrap doc">
    <aside>
      {
        sections.map((s) => (
          <>
            <strong>{s.title}</strong>
            <ol>
              {s.links.map((l) => (
                <li>
                  <a href={url(l.href)} aria-current={here === url(l.href).replace(/\/$/, '') ? 'page' : undefined}>
                    {l.label}
                  </a>
                </li>
              ))}
            </ol>
          </>
        ))
      }
    </aside>
    <article class="prose">
      <h1>{fm.title}</h1>
      <slot />
    </article>
  </div>
</Base>
