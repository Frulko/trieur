---
import { url } from '../lib/url';

const here = Astro.url.pathname.replace(/\/$/, '');
const tabs = [
  { href: '/demos/basic/', label: 'JavaScript API' },
  { href: '/demos/markup/', label: 'Markup API' },
  { href: '/demos/zones/', label: 'Zones & layouts' },
  { href: '/demos/multi/', label: 'Several zones' },
  { href: '/demos/model/', label: 'The model' },
  { href: '/demos/server/', label: 'Light vs full' },
  { href: '/demos/photos/', label: 'Photos' },
  { href: '/demos/tinder/', label: 'Tinder' },
  { href: '/demos/reigns/', label: 'Reigns' },
];
---

<nav style="display:flex;gap:8px;flex-wrap:wrap;margin:0 0 26px">
  {
    tabs.map((t) => (
      <a
        class="btn"
        href={url(t.href)}
        style={here === url(t.href).replace(/\/$/, '') ? 'border-color:var(--accent);color:var(--accent)' : ''}
      >
        {t.label}
      </a>
    ))
  }
</nav>
